# Ignore everything
*

# Let git walk into directories
!*/

# Files at the root of the project
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/CHANGELOG.md
!/HARDWARE.md

# GitHub metadata (the Sponsor button) and the release workflow
!/.github/
!/.github/FUNDING.yml
!/.github/workflows/
!/.github/workflows/*.yml

# The project's code
!/src/**
!/examples/**
!/scripts/**
!/data/**

# The README's screenshots
!/docs/**

# But not the build output
/target/

