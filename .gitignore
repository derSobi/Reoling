# Ignoră tot
*

# Permite traversarea directoarelor
!*/

# Fișierele de la rădăcina proiectului
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md

# Metadate GitHub (butonul Sponsor)
!/.github/
!/.github/FUNDING.yml

# Codul proiectului
!/src/**
!/examples/**
!/data/**

# Dar nu artefactele de build
/target/

# Directoare explicit excluse, fără nicio excepție (referințe externe cu
# propriile lor repo-uri git, plan/spec-uri interne, jurnal local, config
# de unealtă) — trebuie să vină DUPĂ `!*/`, ca reguli mai specifice care
# au prioritate, altfel `!*/` le-ar re-permite ca "embedded git repos".
/other/
/.plans/
/.claude/
